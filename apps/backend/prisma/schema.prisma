generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Department {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  employees Employee[]
}

model Employee {
  id           Int        @id @default(autoincrement())
  firstName    String
  lastName     String?
  department   Department @relation(fields: [departmentId], references: [id])
  departmentId Int
}

model Role {
  id     Int     @id @default(autoincrement())
  title  String  @unique
  person Person?
}

model Person {
  id        Int    @id @default(autoincrement())
  firstName String
  lastName  String
  role      Role   @relation(fields: [roleId], references: [id])
  roleId    Int    @unique
}